# ===================
# FETCHER NOTES
# ===================
#
# ALL SOURCES ARE API-KEY-FREE! 🎉
#
# For YouTube playlists/channels: Use free RSS feeds
#   - Playlist: https://www.youtube.com/feeds/videos.xml?playlist_id={PLAYLIST_ID}
#   - Channel: https://www.youtube.com/feeds/videos.xml?channel_id={CHANNEL_ID}
#   - Parse with feedparser like any other RSS feed
#
# For podcasts: Use feedparser to parse RSS feeds
# For Substack: RSS feeds follow pattern: https://{name}.substack.com/feed
#
# For Hacker News: Free public Firebase API
#   - GET https://hacker-news.firebaseio.com/v0/topstories.json → top 500 IDs
#   - GET https://hacker-news.firebaseio.com/v0/item/{id}.json → story details
#   - Filter by score and recency, then fetch full details
#   - No authentication required!
#
# For Hugging Face: Public API endpoint, no key needed
#   - GET https://huggingface.co/api/daily_papers
#   - Returns JSON array with paper metadata
#
# All sources support looking back 24-72 hours for content

# ===================
# LLM CONFIGURATION (for summaries)
# ===================

llm:
  provider: "google"
  model: "gemini-1.5-flash"  # Fast and cheap, good for summaries
  # Alternative: "gemini-1.5-pro" for higher quality

  # Get free API key at: https://aistudio.google.com/apikey
  # Free tier: 15 RPM, 1M tokens/day - more than enough!
  # Set as environment variable: GOOGLE_API_KEY

  summary_prompt: |
    Summarize this article in exactly 2 sentences (max 50 words total).
    Focus on: what happened, why it matters, and any industrial AI implications.
    Be factual and specific. No fluff.

    Title: {title}
    Source: {source}
    Content: {description}

    Summary:

